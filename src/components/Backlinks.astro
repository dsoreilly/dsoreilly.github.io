---
import { getBacklinkMap } from "../utils/backlinks";

interface Props {
  noteId: string;
}

const { noteId } = Astro.props;
const linkMap = await getBacklinkMap();
const backlinks = linkMap.get(noteId) || [];
---

{
  backlinks.length > 0 && (
    <>
      <hr class="border-rp-highlight-high mt-12 border-t" />
      <h3 class="text-rp-text mt-8 mb-3 font-serif text-xl font-semibold">
        Backlinks
      </h3>
      <ul class="list-disc ps-6.5">
        {backlinks.map((link) => (
          <li class="marker:text-rp-muted ps-1.5">
            <a href={`/notes/${link.slug}/`} class="text-rp-iris underline">
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
