---
import FormattedDate from "./FormattedDate.astro";
import StatusIndicator from "./StatusIndicator.astro";

interface Props {
  title: string;
  status: "sprouting" | "budding" | "evergreen";
  dateCreated: Date;
  dateUpdated?: Date;
}

const { title, status, dateCreated, dateUpdated } = Astro.props;
---

<h1 class="text-rp-text mb-8 font-serif text-4xl font-extrabold">
  {title}
</h1>
<ul class="text-rp-text mb-12">
  <li>
    <span class="mr-1 inline-block w-6">
      <StatusIndicator status={status} />
    </span>
  </li>
  <li>
    <span class="mr-1 inline-block w-6">
      <em>c.</em>
    </span>
    <FormattedDate date={dateCreated} />
  </li>
  {
    dateUpdated && (
      <li>
        <span class="mr-1 inline-block w-6">
          <em>r.</em>
        </span>
        <FormattedDate date={dateUpdated} />
      </li>
    )
  }
</ul>
<hr class="border-rp-highlight-high mb-12 border-t" />
