---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "../consts";

const Heading = Astro.url.pathname === "/" ? "h1" : "h2";
---

<header>
  <div class="flex items-center justify-between py-12">
    <nav>
      <Heading class="text-rp-text font-serif font-bold">
        <a href="/" class="hover:text-rp-iris">{SITE_TITLE}</a>
      </Heading>
    </nav>
    <ThemeToggle />
  </div>
</header>
