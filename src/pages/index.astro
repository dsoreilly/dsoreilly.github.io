---
import Prose from "../components/Prose.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";

const note = (await getCollection("notes")).sort(
  (a, b) =>
    (b.data.dateRevised?.valueOf() ?? b.data.datePublished.valueOf()) -
    (a.data.dateRevised?.valueOf() ?? a.data.datePublished.valueOf()),
)[0];
---

<BaseLayout title={SITE_TITLE}>
  <Prose>
    <p>
      Inspired by the concept of the “digital garden,” this is a space where I
      collect thoughts and cultivate ideas about software engineering amongst
      other topics. Feel free to explore; these writings are in varying states
      of completion, but you might stumble upon something interesting. You can
      start here <a href={`/notes/${note.id}/`}
        >{note.data.title} (<FormattedDate date={note.data.datePublished} />)</a
      > and see where it takes you.
    </p>
  </Prose>
</BaseLayout>
